# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public URL of the site, used in sign-up confirmation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Free key from https://fdc.nal.usda.gov/api-key-signup (optional; the shared DEMO_KEY is heavily rate limited).
# Server-only secret: never commit a real value or add a NEXT_PUBLIC_ prefix.
USDA_API_KEY=
# Shown on the privacy and terms pages as the contact for questions and data requests
NEXT_PUBLIC_CONTACT_EMAIL=
